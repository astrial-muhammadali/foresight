# ForeSight ETH local configuration template.
# Copy to .env and populate it using the connection details shared privately.
# Live server addresses and credentials must never be committed here.
# Blank required fields are intentional; the template cannot connect as supplied.

KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=
KAFKA_ENVIRONMENT_TOPIC=foresight.eth.environment
KAFKA_OBSERVATIONS_TOPIC=foresight.eth.observations
KAFKA_CONSUMER_GROUP=foresight-c3i
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SEND_TIMEOUT_SECONDS=30

# Use the S3 API host:port, without a URL scheme or console port.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET=foresight-eth-images
MINIO_TIMEOUT_SECONDS=15

RECEIVED_IMAGES_DIR=received_images
LOG_LEVEL=INFO
