# Local settings and deployment details; only sanitized examples are shared.
.env
.env.*
!.env.example
*.local
private/
credentials/
secrets/
*.pem
*.key
*.p12
*.pfx

# Python environments and generated output, at any partner-directory depth.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ETH live workflow output can contain deployment-specific information.
ETH/received_images/*
!ETH/received_images/.gitkeep

# Local editors and operating system files.
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
